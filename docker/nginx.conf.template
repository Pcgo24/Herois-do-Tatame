user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    access_log /dev/stdout;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;

    # Cobre o upload de 5 MB da ficha assinada com folga.
    client_max_body_size 10M;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    server {
        # ${PORT} é substituído no start.sh — o Render escolhe a porta.
        listen ${PORT} default_server;
        server_name _;
        root /var/www/html/public;
        index index.php;

        charset utf-8;

        # O Render termina o TLS antes de chegar aqui; sem isso o Laravel gera
        # URLs http:// e o Livewire quebra por conteúdo misto.
        real_ip_header X-Forwarded-For;
        set_real_ip_from 0.0.0.0/0;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location = /favicon.ico { access_log off; log_not_found off; }
        location = /robots.txt  { access_log off; log_not_found off; }

        location ~ ^/build/ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            try_files $uri =404;
        }

        location ~ \.php$ {
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            include fastcgi_params;
            fastcgi_hide_header X-Powered-By;
            fastcgi_read_timeout 60;
        }

        # Nada de .env, .git e afins servidos como arquivo estático.
        location ~ /\.(?!well-known).* {
            deny all;
        }

        error_page 404 /index.php;
    }
}
